# ---------------------------------------------------------------
# Salin file ini menjadi .env.local (lokal) atau isi di Netlify
# Settings → Environment Variables.
# ---------------------------------------------------------------

# Supabase (Project Settings → API). SERVICE ROLE KEY = rahasia, hanya server.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password login panel /admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Minimal 32 karakter acak. Contoh membuat: openssl rand -hex 32
SESSION_SECRET=

# true  = pakai data proxy palsu (tanpa API key asli)
# false = panggil API Webshare sungguhan (produksi)
# Catatan: jika true DAN SUPABASE_URL dikosongkan, aplikasi memakai database
# sementara di memori (khusus coba-coba lokal, data hilang saat restart).
WEBSHARE_TEST_MODE=true

# Alamat publik aplikasi (tanpa garis miring di akhir). Dipakai untuk judul &
# gambar preview saat link dibagikan. Default: https://dmproxy.xyz
SITE_URL=https://dmproxy.xyz

# Alamat lama yang ingin dialihkan ke SITE_URL, mis. namaproject.netlify.app.
# Kosongkan jika kedua alamat boleh jalan berdampingan.
LEGACY_HOST=

# Pita pengumuman di halaman customer. Kosong = tidak tampil.
PENGUMUMAN=
# Opsional, format YYYY-MM-DD. Lewat 23:59 WIB tanggal ini pengumuman hilang sendiri.
PENGUMUMAN_SAMPAI=

# ---------------------------------------------------------------
# Checkout mandiri (invoice + pembayaran manual)
# ---------------------------------------------------------------

# true = checkout mandiri aktif (katalog, invoice, pembayaran manual).
# Kosong/false = pembelian kembali lewat WhatsApp dan tabel invoices tidak
# pernah disentuh. JANGAN dinyalakan sebelum migrasi 0005 dijalankan di
# Supabase. Mengubah nilainya perlu deploy ulang.
CHECKOUT_ENABLED=false

# Webhook Discord untuk kabar invoice baru & customer mengaku sudah bayar.
# RAHASIA: siapa pun yang punya URL ini bisa mengirim pesan ke channel Anda.
# Kosong = notifikasi Discord mati total.
DISCORD_WEBHOOK_URL=

# ID Discord yang di-mention saat ada invoice yang perlu dicek (17-20 digit).
DISCORD_MENTION_ID=

# Rekening tujuan, format "nomor|atas nama". Kosong = pakai bawaan di lib/payment.ts.
BANK_BCA=
BANK_BRI=
# Nama di QRIS dan letak gambarnya (bawaan: /qris.png di folder public).
QRIS_NAMA=
QRIS_IMAGE=

# Tanggal (YYYY-MM-DD, WIB) mulai PESANAN BARU wajib dibuka lewat akun.
# Yang dibandingkan adalah tanggal pesanan dibuat, bukan tanggal hari ini —
# pesanan lama selamanya bisa dibuka cukup dengan nomor pesanan.
# Kosong = belum berlaku untuk siapa pun.
CUSTOMER_LOGIN_REQUIRED_FROM=
